---
- name: Set hostname to the inventory name
  ansible.builtin.hostname:
    name: "{{ inventory_hostname }}"

- name: Mask Zincati
  ansible.builtin.systemd:
    name: zincati.service
    enabled: false
    masked: true
    state: stopped

- name: Load kernel modules now
  community.general.modprobe:
    name: "{{ item }}"
    state: present
  loop: [overlay, br_netfilter]

- name: Persist modules across reboot
  ansible.builtin.copy:
    dest: /etc/modules-load.d/k8s.conf
    content: "overlay\nbr_netfilter\n"
    mode: "0644"

- name: Kubernetes sysctls
  ansible.builtin.copy:
    dest: /etc/sysctl.d/99-k8s.conf
    content: |
      net.bridge.bridge-nf-call-iptables  = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward                 = 1
    mode: "0644"

- name: Kubernetes package repo
  ansible.builtin.yum_repository:
    name: kubernetes
    description: Kubernetes
    baseurl: "https://pkgs.k8s.io/core:/stable:/v{{ k8s_version }}/rpm/"
    gpgcheck: true
    gpgkey: "https://pkgs.k8s.io/core:/stable:/v{{ k8s_version }}/rpm/repodata/repomd.xml.key"


- name: Layer CRI-O (Fedora) + kube tooling (pkgs.k8s.io)
  community.general.rpm_ostree_pkg:
    name:
      - cri-o
      - kubelet
      - kubeadm
      - kubectl
    state: present
  register: layering

- name: Reboot into the new deployment
  ansible.builtin.reboot:
    reboot_timeout: 600
  when: layering.changed

- name: Enable + start CRI-O
  ansible.builtin.systemd:
    name: crio
    enabled: true
    state: started

- name: Enable kubelet (idles until kubeadm configures it)
  ansible.builtin.systemd:
    name: kubelet
    enabled: true

- name: /etc/hosts entry for the control-plane endpoint
  ansible.builtin.lineinfile:
    path: /etc/hosts
    line: "{{ control_plane_ip }} {{ control_plane_endpoint }}"
    regexp: " {{ control_plane_endpoint }}$"

- name: Find CRI-O bridge CNI configs
  ansible.builtin.find:
    paths: /etc/cni/net.d
    patterns: "*crio*"
  register: crio_cni

- name: Remove them so Cilium is the only CNI
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: absent
  loop: "{{ crio_cni.files }}"
